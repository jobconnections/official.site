---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'ja' | 'en' | 'pt-br';
  ogImage?: string;
}

const { title, description, lang = 'ja', ogImage = '/assets/img/logo.avif' } = Astro.props;
const siteUrl = 'https://www.jobconnections.jp';
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();

const ogLocales = {
  'ja': 'ja_JP',
  'en': 'en_US',
  'pt-br': 'pt_BR'
};
const ogLocale = ogLocales[lang] || 'ja_JP';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#185B9D">

    <link rel="canonical" href={currentUrl}>
    
    <link rel="alternate" hreflang="ja" href={new URL(currentUrl.replace(/\/(en|pt-br)\//, '/').replace(/\/(en|pt-br)$/, '/'), siteUrl).toString()}>
    <link rel="alternate" hreflang="en" href={new URL('/en' + currentUrl.replace(/\/(en|pt-br)\//, '/').replace(/\/(en|pt-br)$/, '/'), siteUrl).toString().replace('//', '/')}>
    <link rel="alternate" hreflang="pt-br" href={new URL('/pt-br' + currentUrl.replace(/\/(en|pt-br)\//, '/').replace(/\/(en|pt-br)$/, '/'), siteUrl).toString().replace('//', '/')}>
    <link rel="alternate" hreflang="x-default" href={new URL(currentUrl.replace(/\/(en|pt-br)\//, '/').replace(/\/(en|pt-br)$/, '/'), siteUrl).toString()}>

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/img/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16x16.png">
    <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={currentUrl}>
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()}>
    <meta property="og:site_name" content="JOB CONNECTIONS株式会社">
    <meta property="og:locale" content={ogLocale}>
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/font.awesome.min.css">

    <slot name="head" />
</head>
<body class="font-noto bg-white text-gray-800 antialiased overflow-x-hidden">
    <Header lang={lang} />
    <main>
        <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline src="/assets/js/script.js"></script>
</body>
</html>
