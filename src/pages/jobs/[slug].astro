---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs', (entry) => {
    const isJa = entry.id.startsWith('ja/') || entry.id.startsWith('ja\\') || entry.id.endsWith('/ja.md') || entry.id.endsWith('/ja');
    return isJa && entry.data.status === 'published';
  });
  
  return jobs.map(job => {
    const cleanId = job.id.replace(/\.md$/, '').replace(/\\/g, '/');
    const parts = cleanId.split('/');
    const slug = (parts[0] === 'ja' || parts[0] === 'en' || parts[0] === 'pt-br') 
      ? parts[parts.length - 1] 
      : parts[0];
    return {
      params: { slug },
      props: { job },
    };
  });
}

const { job } = Astro.props;
const { slug } = Astro.params;

const siteUrl = 'https://www.jobconnections.jp';

// 応募フォームURL（求人情報・必須設定パラメータ付き）
const applyUrl = `/apply/?job=${encodeURIComponent(slug || '')}&title=${encodeURIComponent(job.data.title)}&reqInfo=${encodeURIComponent(job.data.requiredInfo || '')}&reqPhone=${job.data.requirePhone ? '1' : '0'}`;

// 勤務地テキスト生成
const locationText = job.data.locationDetail 
  ? `${job.data.prefecture} ${job.data.locationDetail}`
  : job.data.prefecture;

// 雇用形態テキスト（配列対応）
const employmentTypes = Array.isArray(job.data.employmentType) 
  ? job.data.employmentType 
  : [job.data.employmentType];

// 給与テキスト生成
const salaryText = job.data.salaryUpperLimit
  ? `${job.data.salaryType} ${job.data.salaryAmount.toLocaleString()}円〜${job.data.salaryUpperLimit.toLocaleString()}円`
  : `${job.data.salaryType} ${job.data.salaryAmount.toLocaleString()}円`;

// 日付フォーマット用関数 (YYYY-MM-DD)
const formatDateISO = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
};

// Google Job Search JSON-LD の生成
const mapEmploymentType = (t: string) => {
  if (t === '正社員') return 'FULL_TIME';
  if (t === 'アルバイト・パート') return 'PART_TIME';
  if (t === '派遣社員' || t === '紹介予定派遣') return 'CONTRACTOR';
  if (t === '契約社員') return 'CONTRACTOR';
  if (t === '業務委託') return 'CONTRACTOR';
  if (t === '新卒・インターン') return 'INTERN';
  return 'OTHER';
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "title": job.data.title,
  "datePosted": formatDateISO(job.data.datePosted),
  ...(job.data.validThrough && { "validThrough": formatDateISO(job.data.validThrough) }),
  "employmentType": employmentTypes.map(mapEmploymentType),
  "description": job.data.jobDescription,
  "hiringOrganization": {
    "@type": "Organization",
    "name": job.data.companyName,
    "sameAs": siteUrl
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": locationText,
      "addressRegion": job.data.prefecture,
      "addressCountry": "JP"
    }
  },
  "baseSalary": {
    "@type": "MonetaryAmount",
    "currency": "JPY",
    "value": {
      "@type": "QuantitativeValue",
      "value": job.data.salaryAmount,
      ...(job.data.salaryUpperLimit && { "maxValue": job.data.salaryUpperLimit }),
      "unitText": job.data.salaryType === '時給' ? 'HOUR' :
                  job.data.salaryType === '日給' ? 'DAY' : 'MONTH'
    }
  },
  "inLanguage": "ja"
};

// お問い合わせ先プレースホルダー（運用時に変更）
const whatsappUrl = 'https://wa.me/819000000000'; // FIXME
const lineUrl = 'https://line.me/R/ti/p/@placeholder'; // FIXME
const emailUrl = 'mailto:info@jobconnections.jp'; // FIXME

---

<BaseLayout 
  title={`${job.data.title} | 求人詳細 | JOB CONNECTIONS株式会社`} 
  description={`${locationText}での${job.data.title}の求人情報です。`}
  ogImage={job.data.image}
>
    <!-- JSON-LD を head に挿入 -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <div class="bg-gray-50 py-12 md:py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- 戻るリンク -->
            <a href="/jobs/" class="inline-flex items-center text-gray-500 hover:text-primary transition mb-8 text-sm font-medium">
                <i class="fa-solid fa-arrow-left mr-2"></i> 求人一覧へ戻る
            </a>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                {job.data.image && (
                    <div class="w-full h-64 md:h-80 bg-gray-200">
                        <img src={job.data.image} alt={job.data.title} class="w-full h-full object-cover" />
                    </div>
                )}
                
                <div class="p-6 md:p-10">
                    <div class="mb-8">
                        <div class="flex flex-wrap gap-2 mb-3">
                            {employmentTypes.map(et => (
                                <span class="inline-block px-3 py-1 bg-blue-50 text-primary text-xs font-bold rounded-full">
                                    {et}
                                </span>
                            ))}
                        </div>
                        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2 leading-tight">{job.data.title}</h1>
                        <p class="text-sm text-gray-600 mb-2">{job.data.companyName}</p>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
                            <span class="flex items-center gap-1.5">
                                <i class="fa-regular fa-clock"></i> 掲載日: {formatDateISO(job.data.datePosted)}
                            </span>
                            {job.data.validThrough && (
                                <span class="flex items-center gap-1.5 text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full text-xs font-semibold">
                                    <i class="fa-regular fa-calendar-check"></i> 応募締切: {formatDateISO(job.data.validThrough)}
                                </span>
                            )}
                        </div>
                    </div>

                    <!-- 募集条件ハイライト -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 p-6 bg-gray-50 rounded-xl border border-gray-100">
                        <div class="flex items-start">
                            <i class="fa-solid fa-location-dot w-6 text-primary mt-1 text-lg"></i>
                            <div>
                                <p class="text-xs font-bold text-gray-500 mb-1">勤務地</p>
                                <p class="text-gray-900 font-medium">{locationText}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <i class="fa-solid fa-yen-sign w-6 text-primary mt-1 text-lg"></i>
                            <div>
                                <p class="text-xs font-bold text-gray-500 mb-1">給与</p>
                                <p class="text-gray-900 font-medium">{salaryText}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <i class="fa-solid fa-briefcase w-6 text-primary mt-1 text-lg"></i>
                            <div>
                                <p class="text-xs font-bold text-gray-500 mb-1">雇用形態・働き方</p>
                                <p class="text-gray-900 font-medium">{employmentTypes.join('、')}</p>
                            </div>
                        </div>
                        {job.data.jobCategory && (
                            <div class="flex items-start">
                                <i class="fa-solid fa-tag w-6 text-primary mt-1 text-lg"></i>
                                <div>
                                    <p class="text-xs font-bold text-gray-500 mb-1">職種</p>
                                    <p class="text-gray-900 font-medium">{job.data.jobCategory}</p>
                                </div>
                            </div>
                        )}
                    </div>

                    <!-- 求人の特徴タグ -->
                    {job.data.jobFeatures && job.data.jobFeatures.length > 0 && (
                        <div class="flex flex-wrap gap-2 mb-10">
                            {job.data.jobFeatures.map(feature => (
                                <span class="inline-block px-3 py-1 bg-blue-50 text-primary text-sm font-medium rounded-full border border-blue-100">
                                    {feature}
                                </span>
                            ))}
                        </div>
                    )}

                    <!-- 必要とされる日本語能力 -->
                    {(job.data.japaneseSpeaking || job.data.japaneseReading || job.data.japaneseWriting || (job.data.japaneseJlpt && job.data.japaneseJlpt !== '問わない')) && (
                        <div class="mb-10 p-6 bg-blue-50/50 rounded-xl border border-blue-100">
                            <h3 class="text-sm font-bold text-gray-900 mb-4 flex items-center gap-2">
                                <i class="fa-solid fa-language text-primary text-lg"></i> 必要とされる日本語能力
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div class="bg-white p-4 rounded-lg shadow-sm border border-blue-50">
                                    <p class="text-xs font-bold text-gray-500 mb-1 flex items-center gap-1.5">
                                        <i class="fa-solid fa-comments text-primary"></i> 会話 (Speaking)
                                    </p>
                                    <p class="text-gray-900 font-bold text-sm">{job.data.japaneseSpeaking || '問わない'}</p>
                                </div>
                                <div class="bg-white p-4 rounded-lg shadow-sm border border-blue-50">
                                    <p class="text-xs font-bold text-gray-500 mb-1 flex items-center gap-1.5">
                                        <i class="fa-solid fa-book-open text-primary"></i> 読み (Reading)
                                    </p>
                                    <p class="text-gray-900 font-bold text-sm">{job.data.japaneseReading || '問わない'}</p>
                                </div>
                                <div class="bg-white p-4 rounded-lg shadow-sm border border-blue-50">
                                    <p class="text-xs font-bold text-gray-500 mb-1 flex items-center gap-1.5">
                                        <i class="fa-solid fa-pen-nib text-primary"></i> 書き (Writing)
                                    </p>
                                    <p class="text-gray-900 font-bold text-sm">{job.data.japaneseWriting || '問わない'}</p>
                                </div>
                            </div>
                            {job.data.japaneseJlpt && job.data.japaneseJlpt !== '問わない' && (
                                <p class="text-xs text-gray-600 mt-3 pt-3 border-t border-blue-100 flex items-center gap-2">
                                    <span class="font-bold text-primary">JLPT目安:</span> {job.data.japaneseJlpt}
                                </p>
                            )}
                        </div>
                    )}

                    <!-- 仕事内容 -->
                    <div class="mb-10">
                        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 pb-2 border-b-2 border-primary" style="border-bottom-width: 3px;">
                            <i class="fa-solid fa-file-lines text-primary"></i> 仕事内容
                        </h2>
                        <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.jobDescription}</div>
                    </div>

                    <!-- この仕事のやりがい -->
                    {job.data.jobAppeal && (
                        <div class="mb-10">
                            <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 pb-2 border-b-2 border-primary" style="border-bottom-width: 3px;">
                                <i class="fa-solid fa-heart text-primary"></i> この仕事のやりがい
                            </h2>
                            <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.jobAppeal}</div>
                        </div>
                    )}

                    <!-- 対象となる方 -->
                    {job.data.targetCandidates && (
                        <div class="mb-10">
                            <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 pb-2 border-b-2 border-primary" style="border-bottom-width: 3px;">
                                <i class="fa-solid fa-user-check text-primary"></i> 対象となる方
                            </h2>
                            <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.targetCandidates}</div>
                        </div>
                    )}

                    <!-- 働く条件 -->
                    {(job.data.transportationNotes || job.data.benefits || job.data.workingHours) && (
                        <div class="mb-10">
                            <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 pb-2 border-b-2 border-primary" style="border-bottom-width: 3px;">
                                <i class="fa-solid fa-clipboard-list text-primary"></i> 働く条件
                            </h2>
                            <div class="space-y-4">
                                {job.data.transportationNotes && (
                                    <div>
                                        <p class="text-sm font-bold text-gray-600 mb-1">交通手段・勤務地補足</p>
                                        <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.transportationNotes}</div>
                                    </div>
                                )}
                                {job.data.benefits && (
                                    <div>
                                        <p class="text-sm font-bold text-gray-600 mb-1">給与補足・福利厚生</p>
                                        <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.benefits}</div>
                                    </div>
                                )}
                                {job.data.workingHours && (
                                    <div>
                                        <p class="text-sm font-bold text-gray-600 mb-1">勤務時間・休日</p>
                                        <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.workingHours}</div>
                                    </div>
                                )}
                            </div>
                        </div>
                    )}

                    <!-- 選考・応募要項 -->
                    {(job.data.selectionProcess || job.data.requiredInfo) && (
                        <div class="mb-10">
                            <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 pb-2 border-b-2 border-primary" style="border-bottom-width: 3px;">
                                <i class="fa-solid fa-clipboard-check text-primary"></i> 選考・応募について
                            </h2>
                            <div class="space-y-4">
                                {job.data.requiredInfo && (
                                    <div>
                                        <p class="text-sm font-bold text-gray-600 mb-1">応募時の必要書類・項目</p>
                                        <div class="inline-block px-3 py-1 bg-gray-100 text-gray-800 text-sm font-semibold rounded-md border border-gray-200">
                                            {job.data.requiredInfo}
                                        </div>
                                    </div>
                                )}
                                {job.data.selectionProcess && (
                                    <div>
                                        <p class="text-sm font-bold text-gray-600 mb-1">選考フロー</p>
                                        <div class="text-gray-700 leading-relaxed whitespace-pre-wrap">{job.data.selectionProcess}</div>
                                    </div>
                                )}
                            </div>
                        </div>
                    )}

                    <div class="mt-12 pt-8 border-t border-gray-100">
                        <h3 class="text-center font-bold text-gray-900 mb-6">この求人に応募・問い合わせる</h3>
                        
                        <div class="flex flex-col gap-4 max-w-sm mx-auto">
                            <!-- 応募フォーム -->
                            <a href={applyUrl} class="w-full bg-primary hover:bg-blue-800 text-white text-center py-4 rounded-full font-bold shadow-md transition flex justify-center items-center gap-2">
                                <i class="fa-solid fa-paper-plane"></i> フォームから応募する
                            </a>

                            <!-- 電話応募ボタン -->
                            {job.data.applicationPhone && (
                                <a href={`tel:${job.data.applicationPhone.replace(/[^0-9+]/g, '')}`} class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-center py-3.5 rounded-full font-bold shadow-sm transition flex justify-center items-center gap-2">
                                    <i class="fa-solid fa-phone text-lg"></i> 電話で応募する ({job.data.applicationPhone})
                                </a>
                            )}
                            
                            <!-- WhatsApp -->
                            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-full bg-[#25D366] hover:bg-[#128C7E] text-white text-center py-3 rounded-full font-bold shadow-sm transition flex justify-center items-center gap-2">
                                <i class="fa-brands fa-whatsapp text-xl"></i> WhatsApp で連絡する
                            </a>
                            
                            <!-- LINE -->
                            <a href={lineUrl} target="_blank" rel="noopener noreferrer" class="w-full bg-[#06C755] hover:bg-[#05B34C] text-white text-center py-3 rounded-full font-bold shadow-sm transition flex justify-center items-center gap-2">
                                <i class="fa-brands fa-line text-xl"></i> LINE で連絡する
                            </a>
                            
                            <!-- Email -->
                            <a href={emailUrl} class="w-full bg-gray-600 hover:bg-gray-700 text-white text-center py-3 rounded-full font-bold shadow-sm transition flex justify-center items-center gap-2">
                                <i class="fa-regular fa-envelope text-xl"></i> メールで連絡する
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
