---
import type { CollectionEntry } from 'astro:content';

interface Props {
  job: CollectionEntry<'jobs'>;
  lang: 'ja' | 'en' | 'pt-br';
}

const { job, lang } = Astro.props;

// 言語ごとのテキスト（シンプルに）
const t = {
  ja: {
    details: '詳細を見る',
    employment: '雇用形態',
    location: '勤務地',
    salary: '給与',
    japaneseLevel: '日本語',
    datePosted: '掲載日',
  },
  en: {
    details: 'View Details',
    employment: 'Emp. Type',
    location: 'Location',
    salary: 'Salary',
    japaneseLevel: 'Japanese',
    datePosted: 'Posted',
  },
  'pt-br': {
    details: 'Ver Detalhes',
    employment: 'Tipo',
    location: 'Local',
    salary: 'Salário',
    japaneseLevel: 'Japonês',
    datePosted: 'Postado',
  }
};
const currentT = t[lang];

const salaryText = `${job.data.salary.type} ${job.data.salary.amount.toLocaleString()}${lang === 'ja' ? '円' : ' JPY'}`;
const jobUrl = lang === 'ja' ? `/jobs/${job.id.split('/')[0]}/` : `/${lang}/jobs/${job.id.split('/')[0]}/`;

// 日付のフォーマット (例: 2026.08.06)
const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
};
---

<a href={jobUrl} class="block bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all group overflow-hidden">
    <div class="p-6">
        <div class="flex justify-between items-start mb-4">
            <div>
                <span class="inline-block px-3 py-1 bg-blue-50 text-primary text-xs font-bold rounded-full mb-3">
                    {job.data.employmentType}
                </span>
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors line-clamp-2">
                    {job.data.title}
                </h3>
            </div>
            {job.data.image && (
                <div class="hidden sm:block w-24 h-24 flex-shrink-0 ml-4 rounded-lg overflow-hidden bg-gray-100">
                    <img src={job.data.image} alt="" class="w-full h-full object-cover" />
                </div>
            )}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4 mb-5 text-sm">
            <div class="flex items-center text-gray-600">
                <i class="fa-solid fa-location-dot w-5 text-gray-400"></i>
                <span>{job.data.location.prefecture} {job.data.location.city}</span>
            </div>
            <div class="flex items-center text-gray-600">
                <i class="fa-solid fa-yen-sign w-5 text-gray-400"></i>
                <span class="font-medium text-gray-900">{salaryText}</span>
            </div>
            <div class="flex items-center text-gray-600">
                <i class="fa-solid fa-language w-5 text-gray-400"></i>
                <span>{job.data.japaneseLevel}</span>
            </div>
            <div class="flex items-center text-gray-600">
                <i class="fa-regular fa-calendar w-5 text-gray-400"></i>
                <span>{currentT.datePosted}: {formatDate(job.data.datePosted)}</span>
            </div>
        </div>
    </div>
    <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex justify-between items-center group-hover:bg-blue-50 transition-colors">
        <span class="text-sm font-bold text-primary">{currentT.details}</span>
        <i class="fa-solid fa-arrow-right text-primary group-hover:translate-x-1 transition-transform"></i>
    </div>
</a>
