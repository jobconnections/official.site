---
import type { CollectionEntry } from 'astro:content';

interface Props {
  job: CollectionEntry<'jobs'>;
  lang: 'ja' | 'en' | 'pt-br';
}

const { job, lang } = Astro.props;

// 言語ごとのテキスト（シンプルに）
const t = {
  ja: {
    details: '詳細を見る',
    employment: '雇用形態',
    location: '勤務地',
    salary: '給与',
    japaneseLevel: '日本語',
    datePosted: '掲載日',
  },
  en: {
    details: 'View Details',
    employment: 'Emp. Type',
    location: 'Location',
    salary: 'Salary',
    japaneseLevel: 'Japanese',
    datePosted: 'Posted',
  },
  'pt-br': {
    details: 'Ver Detalhes',
    employment: 'Tipo',
    location: 'Local',
    salary: 'Salário',
    japaneseLevel: 'Japonês',
    datePosted: 'Postado',
  }
};
const currentT = t[lang];

const cleanId = job.id.replace(/\.md$/, '').replace(/\\/g, '/');
const idParts = cleanId.split('/');
const jobSlug = (idParts[0] === 'ja' || idParts[0] === 'en' || idParts[0] === 'pt-br') 
  ? idParts[idParts.length - 1] 
  : idParts[0];

const salaryText = job.data.salaryUpperLimit
  ? `${job.data.salaryType} ${job.data.salaryAmount.toLocaleString()}${lang === 'ja' ? '円' : ' JPY'}〜${job.data.salaryUpperLimit.toLocaleString()}${lang === 'ja' ? '円' : ' JPY'}`
  : `${job.data.salaryType} ${job.data.salaryAmount.toLocaleString()}${lang === 'ja' ? '円' : ' JPY'}`;
const jobUrl = lang === 'ja' ? `/jobs/${jobSlug}/` : `/${lang}/jobs/${jobSlug}/`;

// 勤務地テキスト生成
const locationText = job.data.locationDetail 
  ? `${job.data.prefecture} ${job.data.locationDetail}`
  : job.data.prefecture;

// 日付のフォーマット (例: 2026.08.06)
const formatDate = (date: Date) => {
  const d = new Date(date);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
};
const getSpeakingText = () => {
  const speaking = job.data.japaneseSpeaking;
  if (!speaking) return null;
  if (lang === 'en') {
    if (speaking === '挨拶・簡単な指示') return 'Basic / Greetings';
    if (speaking === '日常会話') return 'Daily Conversation';
    if (speaking === 'ビジネス') return 'Business / Fluent';
    return 'Not Required';
  } else if (lang === 'pt-br') {
    if (speaking === '挨拶・簡単な指示') return 'Básico / Saudações';
    if (speaking === '日常会話') return 'Conversação Diária';
    if (speaking === 'ビジネス') return 'Negócios / Fluente';
    return 'Não exigido';
  }
  return speaking;
};
const speakingText = getSpeakingText();

// 雇用形態テキスト（最初の1つを表示）
const employmentLabel = Array.isArray(job.data.employmentType) 
  ? job.data.employmentType[0] 
  : job.data.employmentType;
---

<a href={jobUrl} class="block bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all group overflow-hidden">
    <div class="p-6">
        <div class="flex justify-between items-start mb-4">
            <div>
                <div class="flex flex-wrap gap-2 mb-3">
                    <span class="inline-block px-3 py-1 bg-blue-50 text-primary text-xs font-bold rounded-full">
                        {employmentLabel}
                    </span>
                    {job.data.jobCategory && (
                        <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 text-xs font-bold rounded-full">
                            {job.data.jobCategory}
                        </span>
                    )}
                </div>
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors line-clamp-2">
                    {job.data.title}
                </h3>
                <p class="text-sm text-gray-500 mt-1">{job.data.companyName}</p>
            </div>
            {job.data.image && (
                <div class="hidden sm:block w-24 h-24 flex-shrink-0 ml-4 rounded-lg overflow-hidden bg-gray-100">
                    <img src={job.data.image} alt="" class="w-full h-full object-cover" />
                </div>
            )}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4 mb-5 text-sm">
            <div class="flex items-center text-gray-600">
                <i class="fa-solid fa-location-dot w-5 text-gray-400"></i>
                <span>{locationText}</span>
            </div>
            <div class="flex items-center text-gray-600">
                <i class="fa-solid fa-yen-sign w-5 text-gray-400"></i>
                <span class="font-medium text-gray-900">{salaryText}</span>
            </div>
            {speakingText && speakingText !== '問わない' && speakingText !== 'Not Required' && speakingText !== 'Não exigido' && (
                <div class="flex items-center text-gray-600">
                    <i class="fa-solid fa-language w-5 text-gray-400"></i>
                    <span>{currentT.japaneseLevel}: {speakingText}</span>
                </div>
            )}
            <div class="flex items-center text-gray-600">
                <i class="fa-regular fa-calendar w-5 text-gray-400"></i>
                <span>{currentT.datePosted}: {formatDate(job.data.datePosted)}</span>
            </div>
            {job.data.validThrough && (
                <div class="flex items-center text-amber-700 col-span-1 sm:col-span-2">
                    <i class="fa-regular fa-calendar-check w-5 text-amber-500"></i>
                    <span class="text-xs font-semibold">{lang === 'ja' ? '応募締切' : lang === 'en' ? 'Deadline' : 'Prazo'}: {formatDate(job.data.validThrough)}</span>
                </div>
            )}
        </div>

        {job.data.jobFeatures && job.data.jobFeatures.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mb-2">
                {job.data.jobFeatures.slice(0, 5).map(feature => (
                    <span class="inline-block px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded-md">{feature}</span>
                ))}
                {job.data.jobFeatures.length > 5 && (
                    <span class="inline-block px-2 py-0.5 text-gray-400 text-xs">+{job.data.jobFeatures.length - 5}</span>
                )}
            </div>
        )}
    </div>
    <div class="bg-gray-50 px-6 py-3 border-t border-gray-100 flex justify-between items-center group-hover:bg-blue-50 transition-colors">
        <span class="text-sm font-bold text-primary">{currentT.details}</span>
        <i class="fa-solid fa-arrow-right text-primary group-hover:translate-x-1 transition-transform"></i>
    </div>
</a>
